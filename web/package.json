{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run sync:all && next dev",
    "build": "bun run sync:all && next build",
    "start": "next start",
    "lint": "eslint",
    "check:verdict": "bun run scripts/check-local-verdict.ts",
    "sync:all": "bun run sync:catalog && bun run sync:emoji-tree && bun run types:api:file",
    "sync:catalog": "bun run scripts/sync-catalog.ts",
    "sync:emoji-tree": "bun run scripts/sync-emoji-tree.ts",
    "types:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/schema.ts",
    "types:api:file": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.ts",
    "check:reclutas": "bun run scripts/check-reclutas-trigger.ts",
    "check:instalacion": "bun run scripts/check-instalacion-trigger.ts",
    "check:xp": "bun run scripts/check-xp-pasos.ts",
    "check:latex": "bun run scripts/check-latex-normalize.ts",
    "check:restante": "bun run scripts/check-restante.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@clerk/localizations": "4.13.8",
    "@clerk/nextjs": "7.6.2",
    "@clerk/react": "6.12.8",
    "@clerk/themes": "^2.4.57",
    "@cortex-js/compute-engine": "^0.119.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.18.1",
    "lucide-react": "1.27.0",
    "mafs": "0.21.0",
    "mathjs": "15.2.0",
    "mathlive": "^0.110.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "nuqs": "2.9.2",
    "openapi-fetch": "0.17.0",
    "posthog-js": "1.407.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@clerk/eslint-plugin": "0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "shadcn": "4.16.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "use-resize-observer@9.1.0": "patches/use-resize-observer@9.1.0.patch"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.1.6"
  }
}
